#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo ""
echo "🔍 PRE-COMMIT: Стартирам проверки..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ============================================================
# 1. LINT-STAGED
# ============================================================
echo "📝 Стъпка 1/3: Lint на променените файлове..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ LINT FAILED — Поправи грешките преди commit!"
  exit 1
fi
echo "✅ Lint: OK"

# Step 2: TypeScript is handled by lint-staged for relevant files.
# No standalone tsc --noEmit needed here to avoid double waiting.

# ============================================================
# 3. SECURITY SCAN
#
# FIX 1 — Интервали в имена на файлове:
#   Старо: git diff ... | xargs grep       ← чупи се при "my file.tsx"
#   Ново:  git diff -z  | xargs -0 grep    ← NUL separator, безопасно
#
# FIX 2 — "key" false positives:
#   Премахнато е \bkey\b напълно.
#   Търсим само конкретни camelCase/snake_case форми:
#   apiKey, api_key, secretKey, secret_key, authToken, accessToken
#   Така console.log("Item key:", key) НИКОГА няма да гръмне.
# ============================================================
echo ""
echo "🔐 Стъпка 2/3: Security scan..."

# FIX 1: -z дава NUL-разделени имена → xargs -0 ги чете правилно
# Работи дори с файлове като "my new component.tsx"
STAGED_FILES=$(git diff --cached --name-only -z --diff-filter=ACM | \
  tr '\0' '\n' | \
  grep -E '\.(ts|tsx|js|jsx)$')

if [ -n "$STAGED_FILES" ]; then

  # --- Hardcoded secrets ---
  SECRET_FOUND=$(echo "$STAGED_FILES" | tr '\n' '\0' | \
    xargs -0 grep -rn \
    -e "coverstar-secret-key" \
    -e 'NEXTAUTH_SECRET\s*=\s*["'"'"'][^"'"'"']\+["'"'"']' \
    -e 'AIza[0-9A-Za-z_-]\{35\}' \
    2>/dev/null)

  if [ -n "$SECRET_FOUND" ]; then
    echo ""
    echo "🚨 КРИТИЧНО: Открит е потенциален SECRET:"
    echo "$SECRET_FOUND"
    echo "❌ Commit ОТМЕНЕН! Използвай .env файлове."
    exit 1
  fi

  # --- console.log с чувствителни данни ---
  # FIX 2: Само точни camelCase/snake_case думи — без общото "key"!
  #
  # ✅ Хваща:  console.log(apiKey)
  # ✅ Хваща:  console.log("token:", authToken)
  # ✅ Хваща:  console.log(accessToken)
  # ❌ НЕ хваща: console.log("Item key:", key)      ← React map key
  # ❌ НЕ хваща: console.log({ keyboard: "value" }) ← false positive
  CONSOLE_LEAK=$(echo "$STAGED_FILES" | tr '\n' '\0' | \
    xargs -0 grep -in \
    -e 'console\.log.*\btoken\b' \
    -e 'console\.log.*\bpassword\b' \
    -e 'console\.log.*\bsecret\b' \
    -e 'console\.log.*\bapiKey\b' \
    -e 'console\.log.*\bapi_key\b' \
    -e 'console\.log.*\bsecretKey\b' \
    -e 'console\.log.*\bsecret_key\b' \
    -e 'console\.log.*\bauthToken\b' \
    -e 'console\.log.*\baccessToken\b' \
    -e 'console\.log.*\bbearer\b' \
    2>/dev/null)

  if [ -n "$CONSOLE_LEAK" ]; then
    echo ""
    echo "⚠️  console.log с чувствителни данни:"
    echo ""
    echo "$CONSOLE_LEAK" | while IFS= read -r line; do
      echo "   🔴 $line"
    done
    echo ""
    echo "❌ Commit ОТМЕНЕН!"
    echo "💡 Замени с: logger.debug() или премахни напълно"
    exit 1
  fi

  # --- .env файлове в staged ---
  ENV_STAGED=$(git diff --cached --name-only | \
    grep -E '^\.env($|\.local$|\.production$|\.staging$)')

  if [ -n "$ENV_STAGED" ]; then
    echo ""
    echo "🚨 КРИТИЧНО: Опитваш се да commit-неш .env файл!"
    echo "   $ENV_STAGED"
    echo "❌ Commit ОТМЕНЕН!"
    echo "💡 echo '$ENV_STAGED' >> .gitignore"
    exit 1
  fi

fi

echo "✅ Security: OK"

# ============================================================
# 4. UNIT TESTS
#
# FIX 3 — Тестовите файлове се включват:
#   Старо: grep -E '\.(ts|tsx)$' | grep -v '\.test\.' | grep -v '\.spec\.'
#          → Ако промениш gallery.test.tsx, тестът НЕ се пуска!
#
#   Ново:  grep -E '\.(ts|tsx)$'   ← БЕЗ филтър
#          → jest --findRelatedTests работи перфектно и с .test.tsx
#          → Ако промениш gallery.test.tsx, ТОЧНО този тест се пуска
# ============================================================
echo ""
echo "🧪 Стъпка 3/3: Unit тестове..."

# FIX 3: Без grep -v — включваме .test.tsx файловете!
# FIX 1: xargs -0 за безопасно четене на файлове с интервали
CHANGED_FILES=$(git diff --cached --name-only -z --diff-filter=ACM | \
  tr '\0' '\n' | \
  grep -E '\.(ts|tsx)$')

if [ -n "$CHANGED_FILES" ]; then
  echo "📋 Засегнати файлове:"
  echo "$CHANGED_FILES" | while IFS= read -r f; do
    # Показва дали е тест файл или сорс файл
    if echo "$f" | grep -qE '\.(test|spec)\.'; then
      echo "   🧪 $f"
    else
      echo "   📄 $f"
    fi
  done
  echo ""

  # Подаваме файловете безопасно с xargs
  # --bail спира при първия failing тест
  echo "$CHANGED_FILES" | tr '\n' '\0' | \
    xargs -0 npx jest --passWithNoTests --bail --findRelatedTests

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ ТЕСТОВЕ FAILED — Поправи failing тестовете!"
    echo "💡 Пусни 'npm run test:watch' за debug"
    exit 1
  fi
  echo "✅ Тестове: OK"
else
  echo "ℹ️  Няма .ts/.tsx промени — тестовете се пропускат"
fi

echo ""
echo "━━━━━━━���━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ PRE-COMMIT: Всички проверки минаха!"
echo ""